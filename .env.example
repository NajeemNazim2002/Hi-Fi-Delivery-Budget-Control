# Neon connection string (Neon dashboard -> Connection Details)
DATABASE_URL="postgresql://USER:PASSWORD@HOST/neondb?sslmode=require"
# Long random string (e.g. run: openssl rand -base64 32)
AUTH_SECRET="change-me-to-a-long-random-string"
# First admin account created by `npm run setup-db`
ADMIN_USERNAME=your_admin_username
ADMIN_PASSWORD="ChangeThisPassword123"
# Rider payment share (percent of total delivery amount)
RIDER_SHARE_PERCENT="70"
